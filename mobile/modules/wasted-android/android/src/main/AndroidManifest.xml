<?xml version="1.0" encoding="utf-8"?>
<!-- Lo nativo de Wasted que no es React Native: se fusiona con el manifiesto de la app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+: para preguntar "¿Qué fue?" con botones cuando llega una transferencia a una persona. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application>
        <!-- Cuadro "¿Qué registras?" del widget y del acceso directo. -->
        <activity
            android:name="app.wasted.android.QuickAddActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/shortcut_add"
            android:taskAffinity=""
            android:theme="@style/Theme.Wasted.Dialog" />

        <!-- Lee solo las notificaciones de Packages.WATCHED, con el permiso que da el usuario. -->
        <service
            android:name="app.wasted.android.NotificationReader"
            android:exported="true"
            android:label="@string/notifications_service"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Botones de la notificación "¿Qué fue?": ponen la categoría sin abrir la app. -->
        <receiver
            android:name="app.wasted.android.ClassifyReceiver"
            android:exported="false" />

        <!-- Mismo nombre de clase que en la app anterior: el widget que ya está en la pantalla sigue. -->
        <receiver
            android:name="app.wasted.android.BalanceWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
