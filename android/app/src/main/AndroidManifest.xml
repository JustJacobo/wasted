<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Para mostrar cuáles de las apps de pagos están instaladas (Packages.WATCHED). -->
    <queries>
        <package android:name="com.nequi.MobileApp" />
        <package android:name="com.nu.production" />
        <package android:name="com.didiglobal.passenger" />
        <package android:name="com.sdu.didi.psnger" />
        <package android:name="com.ubercab" />
        <package android:name="com.yandex.yango" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wasted"
        android:usesCleartextTraffic="${cleartext}">

        <!-- Verifica el dominio con /.well-known/assetlinks.json (quita la barra de dirección). -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- La app es Wasted en Chrome a pantalla completa (Trusted Web Activity). -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://${host}/" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/paper" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/paper_dark" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/paper" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/paper_dark" />
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="${host}"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- "Administrar datos" del sitio; la TWA agrega un acceso directo que la abre. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL"
                android:value="https://${host}/" />
        </activity>

        <activity
            android:name=".QuickAddActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/shortcut_add"
            android:taskAffinity=""
            android:theme="@style/Theme.Wasted.Dialog" />

        <!-- Recibe wasted://conectar?clave=… desde Ajustes. Siempre pide confirmación. -->
        <activity
            android:name=".ConnectActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Wasted.Dialog"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="conectar"
                    android:scheme="wasted" />
            </intent-filter>
        </activity>

        <!-- Registrar pagos de las notificaciones: wasted://notificaciones desde Ajustes. -->
        <activity
            android:name=".NotificationsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/shortcut_notifications"
            android:taskAffinity=""
            android:theme="@style/Theme.Wasted.Dialog"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="notificaciones"
                    android:scheme="wasted" />
            </intent-filter>
        </activity>

        <!-- Lee solo las notificaciones de Packages.WATCHED, con el permiso que da el usuario. -->
        <service
            android:name=".NotificationReader"
            android:exported="true"
            android:label="@string/notifications_service"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BalanceWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
