<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/connect_title"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/connect_input"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:autofillHints=""
        android:background="@drawable/field"
        android:fontFamily="monospace"
        android:hint="@string/connect_hint"
        android:inputType="textNoSuggestions|textVisiblePassword"
        android:maxLength="64"
        android:paddingHorizontal="14dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/connect_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/connect_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/cancel"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/connect_ok"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/button_ink"
            android:gravity="center"
            android:minWidth="112dp"
            android:paddingHorizontal="20dp"
            android:text="@string/connect_action"
            android:textColor="@color/paper"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
